{
  "$ref": "#/definitions/categories",
  "definitions": {
    "categories": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^b\\d+-c\\d+$",
          "errorMessage": {
            "pattern": "slug 必须形如 b1-c1"
          }
        },
        "boardSlug": {
          "type": "string",
          "pattern": "^b\\d+$"
        },
        "itemCount": {
          "type": "integer",
          "minimum": 1
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "slug",
        "boardSlug",
        "itemCount"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}