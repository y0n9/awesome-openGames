{
  "$ref": "#/definitions/games",
  "definitions": {
    "games": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "desc": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "board": {
          "type": "string",
          "pattern": "^b\\d+$"
        },
        "category": {
          "type": "string",
          "pattern": "^b\\d+-c\\d+$"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "desc",
        "url",
        "board",
        "category"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}