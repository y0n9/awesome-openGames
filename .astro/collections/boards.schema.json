{
  "$ref": "#/definitions/boards",
  "definitions": {
    "boards": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^b\\d+$",
          "errorMessage": {
            "pattern": "slug 必须形如 b1"
          }
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "color": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "slug",
        "order",
        "color",
        "icon"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}